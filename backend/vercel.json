{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/agente/cron/limpiar-historial",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/proyectos/cron/barrido-diario",
      "schedule": "0 4 * * *"
    }
  ]
}
